# Reference only. Generate credentials with scripts/init-compose.py or aog init.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
DEFAULT_USER_PASSWORD=
BASIC_AUTH_PASSWORD=
JWT_SECRET_KEY=
AUTH_ENCRYPTION_SECRET=
# Shared only between the gateway connector and Core; separate from JWT/encryption keys.
AOG_GATEWAY_BRIDGE_SECRET=
POSTGRES_PASSWORD=
AUTH_REQUIRED=true
MCP_CLIENT_AUTH_ENABLED=true
EMAIL_AUTH_ENABLED=true
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true
MCPGATEWAY_DIRECT_PROXY_ENABLED=false
LOG_LEVEL=ERROR
# Local development only. Compose overrides these with PostgreSQL.
DATABASE_URL=sqlite:///data/contextforge.db
AOG_DATABASE_URL=sqlite:///data/orchestration.db
DBOS_SYSTEM_DATABASE_URL=sqlite:///data/dbos.db
AOG_GATEWAY_BACKEND=contextforge
AOG_GATEWAY_URL=http://127.0.0.1:4444
AOG_CORE_URL=http://127.0.0.1:4455
AGENTPORT_CORE_URL=http://127.0.0.1:4455
# Agent workers must resolve/reach this address. Set the private HTTPS gateway URL for remote devices.
AOG_INTERNAL_GATEWAY_URL=http://gateway:4444
# Only allow the private destinations operated by this installation. Add a DGX /32 when needed.
SSRF_ALLOW_PRIVATE_NETWORKS=false
SSRF_ALLOWED_NETWORKS=["172.30.71.0/24"]
AGENTPORT_PRIVATE_SUBNET=172.30.71.0/24
VALIDATION_MAX_RPC_PARAM_SIZE=33554432
MCPGATEWAY_A2A_ENABLED=false
LLM_API_ENABLED=false
# Optional deployment profile:
KOMODO_URL=http://komodo:9120
KOMODO_API_KEY=
KOMODO_API_SECRET=
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
KOMODO_DATABASE_PASSWORD=
KOMODO_ADMIN_PASSWORD=
# Change both values for HTTPS access.
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000
AGENTPORT_HOST=localhost
