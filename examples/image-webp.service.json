{
  "schema_version": 2,
  "name": "Photo to WebP",
  "kind": "tool",
  "transport": "http",
  "endpoint": "http://image-converter:8080/convert",
  "runtime_id": null,
  "health_url": "http://image-converter:8080/health",
  "lifecycle": "manual",
  "location": "local",
  "egress_policy": "isolated",
  "idempotent": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "image_base64": {
        "type": "string",
        "title": "PNG or JPEG photo",
        "contentEncoding": "base64",
        "maxLength": 27962028,
        "description": "PNG/JPEG, at most 20 MiB and 16 megapixels. Processed on the CPU."
      },
      "quality": {"type": "integer", "title": "WebP quality", "minimum": 1, "maximum": 100, "default": 80}
    },
    "required": ["image_base64"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "filename": {"type": "string"},
      "media_type": {"type": "string", "const": "image/webp"},
      "content_base64": {"type": "string", "contentEncoding": "base64"},
      "sha256": {"type": "string"},
      "width": {"type": "integer"},
      "height": {"type": "integer"}
    },
    "required": ["filename", "media_type", "content_base64", "sha256", "width", "height"],
    "additionalProperties": false
  }
}
