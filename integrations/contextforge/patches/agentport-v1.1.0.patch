+++ b/upstream/contextforge/mcpgateway/agentport.py
@@ -0,0 +1,202 @@
+"""Explicit AgentPort integration points for this controlled ContextForge fork.
+
+Copyright 2026 AgentPort contributors
+SPDX-License-Identifier: Apache-2.0
+"""
+
+import time
+from collections.abc import Awaitable, Callable, Mapping
+from contextlib import asynccontextmanager, contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Any, AsyncContextManager
+
+from fastapi import FastAPI, Request
+
+LOCAL_INTEGRATION = "AGENTPORT_LOCAL"
+LOCAL_NAMESPACE = "io.agentport/local"
+SERVICE_NAMESPACE = "io.agentport/service"
+_backend_tool_id: ContextVar[str | None] = ContextVar("agentport_backend_tool_id", default=None)
+
+
+def is_internal_backend(payload: Mapping[str, Any]) -> bool:
+    """Identify managed backend tools that require a trusted local dispatch."""
+    metadata = payload.get("extension_metadata") or {}
+    binding = metadata.get(SERVICE_NAMESPACE) or {}
+    return isinstance(binding, Mapping) and binding.get("internal") is True
+
+
+@contextmanager
+def backend_invocation(tool_id: str):
+    """Authorize one exact managed backend within the current process context."""
+    if not isinstance(tool_id, str) or not tool_id:
+        raise ValueError("A managed backend tool ID is required")
+    token = _backend_tool_id.set(tool_id)
+    try:
+        yield
+    finally:
+        _backend_tool_id.reset(token)
+
+
+def require_backend_invocation(payload: Mapping[str, Any]) -> None:
+    """Reject direct invocation of managed backends, including operator calls."""
+    if is_internal_backend(payload) and _backend_tool_id.get() != payload.get("id"):
+        raise PermissionError("Managed backend requires an authorized AgentPort run")
+
+
+@dataclass(frozen=True)
+class AuthorizedInvocation:
+    """Carry native authenticated scope without exposing an authentication token."""
+
+    subject: str
+    teams: tuple[str, ...] | None
+    permissions: tuple[str, ...] | None = None
+    server_id: str | None = None
+    token_server_id: str | None = None
+    token_id: str | None = None
+    token_use: str | None = None
+    expires_at: int | None = None
+    auth_method: str | None = None
+    admin_bypass: bool = False
+
+
+@dataclass(frozen=True)
+class LocalTool:
+    """Describe the resolved native catalog entry supplied to a local handler."""
+
+    id: str
+    name: str
+    team_id: str | None
+    owner_email: str | None
+    visibility: str
+    extension_metadata: Mapping[str, Any]
+
+
+LocalHandler = Callable[[AuthorizedInvocation, LocalTool, dict], Awaitable[Any]]
+_handlers: Mapping[str, LocalHandler] = MappingProxyType({})
+_installer: Callable[[FastAPI], None] | None = None
+_lifespan: Callable[[FastAPI], AsyncContextManager] | None = None
+
+
+def configure(*, install_routes=None, lifespan=None, handlers: Mapping[str, LocalHandler] | None = None) -> None:
+    """Configure code-owned handlers before importing the native application."""
+    global _handlers, _installer, _lifespan
+    _handlers = MappingProxyType(dict(handlers or {}))
+    _installer = install_routes
+    _lifespan = lifespan
+
+
+def install(app: FastAPI) -> None:
+    """Install configured routes through the explicit native assembly hook."""
+    if _installer is not None:
+        _installer(app)
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    """Start extension services after native startup and close them before native shutdown."""
+    if _lifespan is None:
+        yield
+    else:
+        async with _lifespan(app):
+            yield
+
+
+def caller_from_request(request: Request, user: Any, server_id: str | None = None) -> AuthorizedInvocation | None:
+    """Capture a caller after native HTTP authentication and scope enforcement."""
+    from mcpgateway.auth_context import (
+        get_internal_mcp_auth_context,
+        get_request_identity,
+        get_scoped_resource_access_context,
+    )
+
+    subject, _ = get_request_identity(request, user)
+    if not subject or subject == "anonymous":
+        return None
+    _, teams = get_scoped_resource_access_context(request, user)
+    internal = get_internal_mcp_auth_context(request)
+    cached = getattr(request.state, "_jwt_verified_payload", None)
+    payload = cached[1] if isinstance(cached, tuple) and len(cached) == 2 and isinstance(cached[1], dict) else {}
+    scopes = payload.get("scopes") or {}
+    token_server = scopes.get("server_id") if isinstance(scopes, dict) else None
+    permissions = getattr(request.state, "token_scopes", None)
+    if internal:
+        token_server = internal.get("scoped_server_id")
+        permissions = internal.get("scoped_permissions")
+    return AuthorizedInvocation(
+        subject=subject,
+        teams=None if teams is None else tuple(teams),
+        permissions=None if permissions is None else tuple(permissions),
+        server_id=server_id,
+        token_server_id=token_server,
+        token_id=getattr(request.state, "jti", None) or payload.get("jti") or (internal or {}).get("token_id"),
+        token_use=getattr(request.state, "token_use", None) or payload.get("token_use") or (internal or {}).get("token_use"),
+        expires_at=int(payload["exp"]) if payload.get("exp") is not None else (internal or {}).get("exp"),
+        auth_method=user.get("auth_method") if isinstance(user, dict) else None,
+        admin_bypass=teams is None,
+    )
+
+
+def caller_from_mcp(user: dict | None, server_id: str | None = None) -> AuthorizedInvocation | None:
+    """Capture the already validated native MCP transport context."""
+    if not user or user.get("is_authenticated") is not True:
+        return None
+    subject = user.get("email")
+    if not subject or subject == "anonymous":
+        return None
+    teams = user.get("teams", [])
+    if teams is None and user.get("is_admin") is not True:
+        return None
+    permissions = user.get("scoped_permissions")
+    return AuthorizedInvocation(
+        subject=subject,
+        teams=None if teams is None else tuple(teams),
+        permissions=None if permissions is None else tuple(permissions),
+        server_id=server_id,
+        token_server_id=user.get("scoped_server_id"),
+        token_id=user.get("token_id"),
+        token_use=user.get("token_use"),
+        expires_at=int(user["exp"]) if user.get("exp") is not None else None,
+        auth_method=user.get("auth_method"),
+        admin_bypass=teams is None and user.get("is_admin") is True,
+    )
+
+
+async def dispatch(caller: AuthorizedInvocation | None, payload: dict, arguments: dict) -> Any:
+    """Invoke a configured local operation after the native tool pipeline authorizes it."""
+    from mcpgateway.middleware.rbac import token_scope_grants
+
+    if not _handlers:
+        raise PermissionError("AgentPort local execution is disabled")
+    if not isinstance(caller, AuthorizedInvocation) or not caller.subject:
+        raise PermissionError("Native authenticated caller context is required")
+    if caller.expires_at is not None and caller.expires_at <= time.time():
+        raise PermissionError("Native caller token has expired")
+    if not token_scope_grants(list(caller.permissions) if caller.permissions is not None else None, "tools.execute"):
+        raise PermissionError("Token does not permit local tool execution")
+    if caller.token_server_id and caller.token_server_id != caller.server_id:
+        raise PermissionError("Token virtual-server scope does not match")
+    metadata = payload.get("extension_metadata") or {}
+    binding = metadata.get(LOCAL_NAMESPACE) or {}
+    operation = binding.get("operation")
+    handler = _handlers.get(operation) if isinstance(operation, str) else None
+    if handler is None:
+        raise PermissionError("Local operation is not registered")
+    tool = LocalTool(
+        id=payload["id"],
+        name=payload["name"],
+        team_id=payload.get("team_id"),
+        owner_email=payload.get("owner_email"),
+        visibility=payload.get("visibility", "private"),
+        extension_metadata=MappingProxyType(metadata),
+    )
+    return await handler(caller, tool, arguments)
+
+
+async def require_local_registration(user: dict, db: Any, request: Request) -> None:
+    """Require native operator permissions before changing local execution bindings."""
+    from mcpgateway.middleware.rbac import check_permission_inline
+
+    if not await check_permission_inline(user, "admin.system_config", db=db, request=request):
+        raise PermissionError("Operator permission is required for local tool bindings")
